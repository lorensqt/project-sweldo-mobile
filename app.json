{
  "expo": {
    "name": "Sweldo-App",
    "slug": "Sweldo-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ps-logo.png",
    "scheme": "sweldoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ps-logo.png",
        "backgroundImage": "./assets/images/ps-logo.png",
        "monochromeImage": "./assets/images/ps-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#00000080",
        "barStyle": "light-content"
      },
      "package": "com.omorfos.SweldoApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ps-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ps-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0b88e83-e1e9-49ed-9f08-6ae0f6400407"
      }
    }
  }
}
